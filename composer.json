{
	"name": "bakuteam/essential",
	"description": "Essential — Minecraft: Bedrock Edition server core by BakuTeam, based on PocketMine-MP.",
	"type": "project",
	"license": "LGPL-3.0-or-later",
	"homepage": "https://github.com/BakuTeam/Essential",
	"minimum-stability": "stable",
	"prefer-stable": true,

	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/locale-data.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/BedrockBlockUpgradeSchema.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/BedrockItemUpgradeSchema.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/BinaryUtils.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/CallbackValidator.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/Color.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/ErrorHandler.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/Log.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/Math.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/NBT.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/RakLib.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/RakLibIpc.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/BakuTeam/Snooze.git"
		}
	],

	"require": {
		"php": ">=8.1",
		"adhocore/json-comment": "^1.2.1",
		"brick/math": "^0.13.1",
		"netresearch/jsonmapper": "^5.0",
		"pocketmine/bedrock-block-upgrade-schema": "^5.2.0",
		"pocketmine/bedrock-item-upgrade-schema": "^1.16.0",
		"pocketmine/binaryutils": "^0.2.6",
		"pocketmine/callback-validator": "^1.0.3",
		"pocketmine/color": "^0.3.1",
		"pocketmine/errorhandler": "^0.7.0",
		"pocketmine/log": "^0.4.0",
		"pocketmine/math": "^1.0.0",
		"pocketmine/nbt": "^1.1.1",
		"pocketmine/raklib": "^1.2.0",
		"pocketmine/raklib-ipc": "^1.0.1",
		"pocketmine/snooze": "^0.5.0",
		"ramsey/collection": "^2.1.1",
		"ramsey/uuid": "^4.9.1",
		"symfony/filesystem": "^6.4.24",

		"bakuteam/locale-data": "dev-main"
	},

	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.89"
	},

	"autoload": {
		"psr-4": {
			"pocketmine\\": "src/"
		},
		"files": [
			"src/CoreConstants.php"
		]
	},

	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
